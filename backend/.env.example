# Copy to .env and fill in. Everything here is optional — the scanner
# pipeline runs fine with none of it set; auth (signup/login) needs a real
# Postgres database to actually work.

# --- scanner (optional) ---
OLLAMA_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=qwen2.5:3b-instruct

# true (default): a scanned barcode must also be corroborated by a matching
# label/name before an item counts as verified. false: barcode alone is
# trusted — a matching barcode verifies the item without checking the label.
STRICT_LABEL_VERIFICATION=true

# --- auth (required for signup/login to work) ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smart_picker
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CLIENT_ORIGIN=http://localhost:5173
COOKIE_NAME=picker_session
